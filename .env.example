# Contact form email delivery (https://resend.com). Set these in Vercel under
# Project Settings > Environment Variables. Without RESEND_API_KEY the form
# offers to send the enquiry on WhatsApp or by email instead.
RESEND_API_KEY=
# Where enquiries go; comma-separate several addresses. Defaults to the
# business email in lib/siteConfig.js.
CONTACT_TO_EMAIL=
# Sender address on a domain verified in Resend, e.g.
# "Visto Homeware website <enquiries@vistohomeware.com>". Defaults to Resend's
# test sender, which only delivers to the Resend account owner's address.
CONTACT_FROM_EMAIL=
